---
import { siteConfig } from "../config";
---

<section
  id="hero"
  class="relative min-h-[100dvh] flex flex-col overflow-hidden"
  style="background: var(--bg)"
>
  <!-- Ambient warm glow -->
  <div
    class="absolute inset-0 pointer-events-none select-none"
    aria-hidden="true"
    style="background: radial-gradient(ellipse 65% 55% at 12% 58%, oklch(78% 0.16 58 / 0.09) 0%, transparent 68%)"
  ></div>

  <!-- Top bar -->
  <div class="relative flex items-center justify-between px-8 sm:px-12 md:px-16 lg:px-20 pt-8 sm:pt-10">
    <span class="text-xs tracking-[0.2em] uppercase select-none" style="color: var(--fg-subtle)">
      {new Date().getFullYear()}
    </span>
    <span class="text-xs tracking-[0.2em] uppercase select-none" style="color: var(--fg-subtle)">
      Portfolio
    </span>
  </div>

  <!-- Main content -->
  <div class="relative flex-1 flex items-center px-8 sm:px-12 md:px-16 lg:px-20 pt-12 pb-8">
    <div>
      <!-- Role -->
      <p
        class="hero-role text-sm tracking-[0.18em] uppercase font-semibold mb-5 sm:mb-7"
        style="color: var(--accent)"
      >
        {siteConfig.title}
      </p>

      <!-- Name -->
      <h1
        class="hero-title font-extrabold tracking-tight"
        style="font-size: clamp(3.5rem, 10vw, 8.5rem); line-height: 0.9; color: var(--fg)"
      >
        {siteConfig.name}
      </h1>

      <!-- Divider -->
      <div
        class="hero-divider mt-8 sm:mt-10 h-px"
        style="background: var(--border); max-width: 440px"
      ></div>

      <!-- Scroll CTA -->
      <a href="#about" class="hero-cta inline-flex items-center gap-2.5 mt-6 sm:mt-8 text-sm">
        <span>Explore work</span>
        <svg
          class="cta-arrow w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Social links -->
  <div
    class="hero-socials relative flex flex-wrap items-center gap-6 sm:gap-8 px-8 sm:px-12 md:px-16 lg:px-20 pb-8 sm:pb-10"
  >
    {siteConfig.social?.email && (
      <a href={`mailto:${siteConfig.social.email}`} class="social-link">Email</a>
    )}
    {siteConfig.social?.github && (
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="social-link">
        GitHub
      </a>
    )}
    {siteConfig.social?.linkedin && (
      <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="social-link">
        LinkedIn
      </a>
    )}
    {siteConfig.social?.twitter && (
      <a href={siteConfig.social.twitter} target="_blank" rel="noopener noreferrer" class="social-link">
        Twitter
      </a>
    )}
  </div>
</section>

<style>
  .hero-cta {
    color: var(--fg-muted);
    transition: color 0.25s ease;
  }

  .hero-cta:hover {
    color: var(--fg);
  }

  .cta-arrow {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-cta:hover .cta-arrow {
    transform: translateY(4px);
  }

  .social-link {
    position: relative;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    transition: color 0.25s ease;
  }

  .social-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--accent);
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .social-link:hover {
    color: var(--fg);
  }

  .social-link:hover::after {
    width: 100%;
  }
</style>
