---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{hasProjects && (
  <section
    id="projects"
    class="px-8 sm:px-12 md:px-16 lg:px-20 py-20 md:py-28 lg:py-36"
    style="background: var(--bg-surface)"
  >
    <div class="max-w-6xl mx-auto">

      <!-- Section label -->
      <div class="reveal flex items-center gap-4 mb-14 sm:mb-20">
        <span class="text-xs tracking-[0.22em] uppercase font-semibold" style="color: var(--accent)">02</span>
        <span class="text-xs tracking-[0.22em] uppercase" style="color: var(--fg-subtle)">Projects</span>
        <div class="flex-1 h-px ml-2" style="background: var(--border)"></div>
        <span class="text-xs tabular-nums" style="color: var(--fg-subtle)">{siteConfig.projects.length}</span>
      </div>

      <!-- List -->
      <div style="border-top: 1px solid var(--border)">
        {siteConfig.projects.map((project, index) => {
          const Tag = project.link ? "a" : "div";
          const linkProps = project.link
            ? { href: project.link, target: "_blank", rel: "noopener noreferrer" }
            : {};

          return (
            <Tag
              {...linkProps}
              class={`reveal stagger-${index + 1} project-row group flex items-start gap-5 sm:gap-10 py-8 sm:py-10`}
            >
              <span
                class="text-xs pt-1.5 shrink-0 tabular-nums font-medium w-5"
                style="color: var(--fg-subtle)"
              >
                0{index + 1}
              </span>

              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-4">
                  <h3 class="project-name font-semibold text-base sm:text-xl leading-snug">
                    {project.name}
                  </h3>
                  {project.link && (
                    <span class="project-arrow shrink-0 mt-0.5 text-sm" style="color: var(--fg-subtle)">↗</span>
                  )}
                </div>

                <p class="mt-2 text-sm sm:text-base leading-relaxed" style="color: var(--fg-muted); max-width: 55ch">
                  {project.description}
                </p>

                {project.skills && project.skills.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-4">
                    {project.skills.map((skill) => (
                      <span
                        class="text-xs px-2 py-1 transition-colors duration-200"
                        style="color: var(--fg-subtle); border: 1px solid var(--border)"
                      >
                        {skill}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </Tag>
          );
        })}
      </div>

    </div>
  </section>
)}

<style>
  .project-row {
    border-bottom: 1px solid var(--border);
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .project-row:hover {
    background: oklch(78% 0.16 58 / 0.04);
    border-bottom-color: oklch(78% 0.16 58 / 0.4);
  }

  .project-name {
    color: var(--fg);
    transition: color 0.2s ease;
  }

  .project-row:hover .project-name {
    color: var(--accent);
  }

  .project-arrow {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
  }

  .project-row:hover .project-arrow {
    transform: translate(3px, -3px);
    color: var(--accent);
  }
</style>
